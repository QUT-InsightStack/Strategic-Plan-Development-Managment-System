# SPMS — Nginx Production Configuration
# Replace spms.dost.gov.ph with the actual domain before use
# Certificate paths assume Let's Encrypt via Certbot
#
# To activate:
#   1. Copy this file to /etc/nginx/sites-available/spms
#   2. Edit all placeholder values
#   3. Run: sudo ln -s /etc/nginx/sites-available/spms /etc/nginx/sites-enabled/
#   4. Run: sudo nginx -t
#   5. Run: sudo systemctl reload nginx

# ─── Redirect HTTP → HTTPS ──────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name spms.dost.gov.ph;

    return 301 https://$host$request_uri;
}

# ─── HTTPS Server ───────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name spms.dost.gov.ph;

    # ── TLS Certificate (Let's Encrypt via Certbot) ──────────────────────
    ssl_certificate     /etc/letsencrypt/live/spms.dost.gov.ph/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spms.dost.gov.ph/privkey.pem;

    # ── TLS Hardening ────────────────────────────────────────────────────
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── HSTS ─────────────────────────────────────────────────────────────
    # Forces HTTPS for 1 year after first visit — only enable once HTTPS is stable
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ── Security Headers ─────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Document Root ────────────────────────────────────────────────────
    # Laravel's public/ folder is the web root — not the project root
    root /var/www/spms/public;
    index index.php;

    # ── Laravel URL Routing ──────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ── PHP-FPM ──────────────────────────────────────────────────────────
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # ── Block access to hidden files (.env, .git, etc.) ──────────────────
    location ~ /\. {
        deny all;
    }
}
